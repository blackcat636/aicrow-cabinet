# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000

# For production, change to your actual API URL:
# NEXT_PUBLIC_API_URL=https://api.yourapp.com
# API_BASE_URL=https://api.yourapp.com

# SSO: config URL (default: ${API_BASE_URL}/auth/sso/config)
# SSO_CONFIG_URL=https://api.yourapp.com/auth/sso/config

# Fallback when SSO config API is unavailable (any domains, comma-separated)
# SSO_CORS_ORIGINS=https://app1.example.com,https://app2.example.com
# SSO_REDIRECT_URIS=https://app1.example.com/callback,https://app2.example.com/sso-callback
